# ─────────────────────────────────────────────────────────────────────────────
# jkbmsr-firmware — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit it; back it
# up somewhere safe. `.env.example` (this file) IS committed.
#
# BUILDING the firmware needs NONE of these — just PlatformIO (`pio run`).
# These are for running the OTA *release* pipeline (normally done in CI). Only
# fill them in if you publish a release from your machine.
# ─────────────────────────────────────────────────────────────────────────────

# Cloudflare token to upload the firmware binary to R2 and update the D1
# firmware metadata row.
# Needs: Account > Workers R2 Storage:Edit, D1:Edit.
# PROD HOME: GitHub Actions secret CLOUDFLARE_API_TOKEN on this repo.
# ROLL AT:   https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OTA metadata signing key — ECDSA P-256 PRIVATE key, base64 of the PEM file.
# This is the most sensitive secret in the platform: anyone with it can sign
# firmware your devices will trust. Keep it offline/escrowed.
# Create:  openssl ecparam -genkey -name prime256v1 -noout -out ota.pem
#          base64 -w0 ota.pem     # <- this value
# ROLL: generate a new keypair, publish the new public key
#   (docs/ota-signing-public-key.pem + the firmware's embedded OtaSigningKey.h),
#   bump OTA_SIGNING_KEY_ID, and ship a firmware update BEFORE retiring the old
#   key (devices verify against the embedded public key).
# HOME: jkbmsr-private/secrets/ota-signing-private.pem (mode 0600, jkbmsr-owned),
# referenced by the gitignored firmware/.env as OTA_SIGNING_PRIVATE_KEY_B64.
OTA_SIGNING_PRIVATE_KEY_B64=

# Secure Boot v2 *development* signing key lives on disk at
# keys/secure_boot_signing_key.pem (gitignored) — generate with
# scripts/generate-secure-boot-dev-key.sh. It is NOT this OTA key and must
# never be the same material. Production Secure Boot keys are Phase 3.

# Identifier published alongside signed metadata so devices/clients can tell
# which key signed a release. Bump when you rotate the signing key.
# HOME: firmware/.env (gitignored). Rotated 2026-10-09.
OTA_SIGNING_KEY_ID=jkbmsr-ota-p256-20261009

# Fine-grained GitHub token with contents:write on jkbmsr/jkbmsr-releases,
# used to push public release artifacts to the CDN mirror. Optional — the
# release still works without the public mirror step.
# PROD HOME: GitHub Actions secret RELEASES_REPO_PUSH_TOKEN on this repo.
# ROLL AT:   https://github.com/settings/tokens
RELEASES_REPO_PUSH_TOKEN=
